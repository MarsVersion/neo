# Static Next.js export on Apache (e.g. IONOS): correct index files, trailing slashes, JS MIME.
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
  AddType font/woff2 .woff2
</IfModule>

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real file (images, _next chunks, favicon): do not rewrite
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /privacy -> /privacy/ when folder export has index.html (Apache often will not
  # pick DirectoryIndex for extensionless directory URLs without the trailing slash)
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>
